<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="italo617">
        <createTable tableName="cake_images">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cake_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="mime_type" type="VARCHAR(31)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="BYTEA">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="cake_images" baseColumnNames="cake_id"
                                 constraintName="fk_cake_images_cakes"
                                 referencedTableName="cakes" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>